LOCAL_PATH := $(call my-dir)

# Flags the prebuilt nntrainer libraries were built with. -march selects the
# instruction set; the ABI defines gate declarations in the public headers (the
# FP16 defines gate the _FP16 type in tensor_dim.h, ENABLE_OPENCL gates the
# cl_context.h member of engine.h), so consumers must compile with the same
# values or the ABI breaks. Exported automatically to every module that links
# these prebuilts; see the filter in jni/meson.build for what qualifies.
NNTRAINER_EXPORT_CFLAGS := @NNTRAINER_ABI_FLAGS@

# LOCAL_SRC_FILES is relative to LOCAL_PATH; prefixing it would duplicate the
# package path when this Android.mk is included relatively.
include $(CLEAR_VARS)

LOCAL_MODULE := ccapi-nntrainer

# LOCAL_SRC_FILES of a prebuilt module is resolved by ndk-build's
# local-prebuilt-path, which prepends LOCAL_PATH to any relative entry. Spelling
# the prefix out here doubles it whenever LOCAL_PATH itself is relative.
# LOCAL_EXPORT_C_INCLUDES below is not resolved that way and keeps its prefix.
LOCAL_SRC_FILES := lib/$(TARGET_ARCH_ABI)/libccapi-nntrainer.so
LOCAL_EXPORT_C_INCLUDES := $(LOCAL_PATH)/include
LOCAL_EXPORT_CFLAGS := $(NNTRAINER_EXPORT_CFLAGS)

include $(PREBUILT_SHARED_LIBRARY)

include $(CLEAR_VARS)

LOCAL_MODULE := nntrainer

LOCAL_SRC_FILES := lib/$(TARGET_ARCH_ABI)/libnntrainer.so
LOCAL_EXPORT_C_INCLUDES := $(LOCAL_PATH)/include $(LOCAL_PATH)/include/nntrainer
LOCAL_EXPORT_CFLAGS := $(NNTRAINER_EXPORT_CFLAGS)

include $(PREBUILT_SHARED_LIBRARY)
